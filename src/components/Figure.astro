---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Max render width in px. Large landscape photos get more; pairs get less. */
  widths?: number;
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  widths = 2000,
  sizes = '(max-width: 720px) 100vw, 1180px',
} = Astro.props;
---

<figure class="photo-figure">
  <Image
    src={src}
    alt={alt}
    widths={[400, 800, 1200, 1600, widths]}
    sizes={sizes}
    loading="lazy"
    decoding="async"
  />
  <figcaption>{caption}</figcaption>
</figure>
